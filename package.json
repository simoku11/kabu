{
  "name": "kabu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @kabu/protocol build && pnpm --filter @kabu/game-core build && pnpm --filter @kabu/web build && pnpm --filter @kabu/server build",
    "dev": "pnpm --parallel --filter @kabu/web --filter @kabu/server dev",
    "load:m8": "pnpm --filter @kabu/server load:m8",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "db:generate": "pnpm --filter @kabu/server db:generate",
    "db:migrate": "pnpm --filter @kabu/server db:migrate",
    "start": "pnpm --filter @kabu/server start",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "5.0.0"
  }
}
