{
  "name": "@kabu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "load:m8": "tsx src/m8-load.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.1.0",
    "@fastify/static": "8.2.0",
    "@kabu/protocol": "workspace:*",
    "@kabu/game-core": "workspace:*",
    "dotenv": "17.2.1",
    "drizzle-orm": "0.44.5",
    "fastify": "5.5.0",
    "postgres": "3.4.7",
    "socket.io": "4.8.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "socket.io-client": "4.8.3",
    "tsx": "4.20.5"
  }
}
