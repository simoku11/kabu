HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://kabu:kabu@localhost:5432/kabu
COOKIE_SECURE=false
# Exakte Browser-Ursprünge, kommasepariert. Für Handytests die von Vite
# ausgegebene Network-Adresse ergänzen, z. B. http://192.168.1.20:5173.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_BODY_LIMIT_BYTES=16384
SOCKET_MESSAGE_LIMIT_BYTES=16384
COMMAND_RATE_LIMIT=240
COMMAND_RATE_WINDOW_MS=10000
JOIN_RATE_LIMIT=10
JOIN_RATE_WINDOW_MS=60000
# Harte Netzabbrüche werden spätestens nach Intervall + Timeout erkannt.
SOCKET_PING_INTERVAL_MS=1000
SOCKET_PING_TIMEOUT_MS=2000
# Nur für die lokale M4–M6-Abnahme aktivieren; in Produktion beide false lassen.
KABU_ENABLE_TEST_SCENARIOS=false
VITE_KABU_TEST_SCENARIOS=false
# Vorläufiger D11-Wert für öffentliche Fehlaufdeckungen (Millisekunden).
KABU_PUBLIC_REVEAL_MS=2500
